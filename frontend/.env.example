# Frontend settings. Every VITE_* value is baked into the public JS bundle.
# Restart `npm run dev:frontend` (or rebuild) after editing. Guide: docs/api-keys-setup.md
VITE_API_BASE_URL=http://localhost:8000
# Same address as middleware ESCROW_CONTRACT_ADDRESS (not needed in demo payment mode)
VITE_ESCROW_ADDRESS=
# Local Hardhat: 31337 / Hardhat Local / (no explorer)
# Sepolia:       11155111 / Sepolia / https://sepolia.etherscan.io
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Local
VITE_EXPLORER_URL=
# DEMO PAYMENT MODE: simulated escrow, Buy needs no wallet. Presentations only.
# Set VITE_DEMO_PAYMENT=true and VITE_DEMO_BUYER_WALLET to a KYC-verified buyer address.
# See docs/demo-payment-mode.md
VITE_DEMO_PAYMENT=
VITE_DEMO_BUYER_WALLET=
# Local demo only: same value as backend DEV_OFFICER_TOKEN to show the officer review screen.
# LEAVE EMPTY on any public deployment, because this value is visible to every visitor.
VITE_OFFICER_TOKEN=
