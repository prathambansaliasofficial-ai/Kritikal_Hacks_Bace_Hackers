{
  "name": "land-market-middleware",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TinyFish evidence gathering + blockchain escrow middleware for Land Market",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "smoke:tinyfish": "tsx scripts/smoke-tinyfish.ts"
  },
  "dependencies": {
    "@tiny-fish/sdk": "^0.11.0",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "hardhat": "^3.21.1",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
