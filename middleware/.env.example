# Middleware service + chain settings. Full guide: docs/api-keys-setup.md
# Check your setup with: npm run check:env   (or: npm run check:env -- sepolia)
PORT=8090
# Keep 127.0.0.1: the middleware has no authentication on settle/refund. Never expose it publicly.
HOST=127.0.0.1

# TinyFish API key. Create one at https://agent.tinyfish.ai/api-keys (shown only once).
# Required for live evidence runs. See docs/keys-tinyfish.md
TINYFISH_API_KEY=
# Leave empty.
TINYFISH_URL=
# Portal opened when the client does not send sourceUrl.
DEFAULT_SOURCE_URL=https://bhunaksha.nic.in/bhunaksha/
TINYFISH_TIMEOUT_MS=290000

# --- Blockchain: LOCAL defaults (Hardhat node). For Sepolia see docs/keys-sepolia.md ---
# Sepolia: set CHAIN_RPC_URL to the same URL as SEPOLIA_RPC_URL and CHAIN_ID=11155111.
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Address printed by deploy:local / deploy:sepolia
ESCROW_CONTRACT_ADDRESS=
# Signer allowed to call settle()/refund(). Must be the SAME account that deployed the contract
# (so on Sepolia it must equal DEPLOYER_PRIVATE_KEY). Use throwaway keys only, never a real one.
OPERATOR_PRIVATE_KEY=
# Sepolia only (used by npm --prefix middleware run deploy:sepolia)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
