# Middleware service + local chain defaults.
PORT=8090
HOST=127.0.0.1

# TinyFish API key (permanent key from hackathon organizers). Required for live evidence runs.
TINYFISH_API_KEY=
# TinyFish URL (optional). Leave empty if using API key only.
TINYFISH_URL=
# Portal opened when the client does not send sourceUrl.
DEFAULT_SOURCE_URL=https://bhunaksha.nic.in/bhunaksha/
TINYFISH_TIMEOUT_MS=290000

# Blockchain (local Hardhat node by default, Sepolia for a public testnet).
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ESCROW_CONTRACT_ADDRESS=
# Backend signer allowed to call settle()/refund(); dev key only, never commit a real one.
OPERATOR_PRIVATE_KEY=
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
