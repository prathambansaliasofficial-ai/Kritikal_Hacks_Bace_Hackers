# Backend settings. Full guide: docs/api-keys-setup.md
APP_ENV=development
# Local Docker PostGIS by default. Hosted (e.g. Supabase): paste its connection string here.
DATABASE_URL=postgresql://landmarket:landmarket_dev@localhost:5432/landmarket
# Private address of the middleware (never a public URL).
MIDDLEWARE_URL=http://127.0.0.1:8090
# Comma-separated list of allowed frontend origins. Add your deployed frontend URL here.
CORS_ORIGINS=http://localhost:5173
MIDDLEWARE_TIMEOUT_SECONDS=90
# Prototype officer token for KYC and evidence review.
# Replace with your own random string before sharing any URL.
DEV_OFFICER_TOKEN=dev-officer-token
